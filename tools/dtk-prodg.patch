+/// Whether the instruction at `addr` is an `ori`.
+fn is_ori_at(obj: &ObjInfo, addr: SectionAddress) -> bool {
+    let section = &obj.sections[addr.section];
+    let Some(offset) = (addr.address as u64).checked_sub(section.address) else {
+        return false;
+    };
+    let offset = offset as usize;
+    match section.data.get(offset..offset + 4) {
+        Some(bytes) => bytes[0] >> 2 == 24,
+        None => false,
+    }
+}
+
+/// Whether `addr` is a `lis rX` immediately followed by `ori rX, rX`.
+fn is_lis_ori_pair(obj: &ObjInfo, addr: SectionAddress) -> bool {
+    let section = &obj.sections[addr.section];
+    let Some(offset) = (addr.address as u64).checked_sub(section.address) else {
+        return false;
+    };
+    let offset = offset as usize;
+    let Some(bytes) = section.data.get(offset..offset + 8) else {
+        return false;
+    };
+    let lis = u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]);
+    let ori = u32::from_be_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]);
+    let rd = (lis >> 21) & 31;
+    lis >> 26 == 15
+        && (lis >> 16) & 31 == 0
+        && ori >> 26 == 24
+        && (ori >> 21) & 31 == rd
+        && (ori >> 16) & 31 == rd
+}
